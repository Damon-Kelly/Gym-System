{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build GymSystem",
            "type": "shell",
            "command": "javac",
            "args": [
                "-cp",
                "sqlite/sqlite-jdbc-3.51.1.0.jar",
                "-d",
                "bin",
                "code/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$javac"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
